VITE_APP_NAME=TA
# API base URL. "/api" works in development: Vite proxies it to the backend.
VITE_API_URL=/api
# Socket.io server URL. Empty = same origin (also proxied in development).
VITE_SOCKET_URL=
# Where the dev server proxies /api and /socket.io
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_PORT=5173
