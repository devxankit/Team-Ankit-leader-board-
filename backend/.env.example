# ── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Browser origin(s) allowed to call the API, comma-separated
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Team_Ankit

# ── Auth ─────────────────────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Only if the frontend and API are on different domains (needs HTTPS):
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# ── App ──────────────────────────────────────────────────────────────
# Timezone for "This week" (starts Monday), "This month" and date filters
APP_TIMEZONE=Asia/Kolkata
# Reverse-proxy hops in front of the API (0 when run directly)
TRUST_PROXY=0
# Serve frontend/dist from Express for a single-origin deploy (defaults to true when NODE_ENV=production)
# SERVE_CLIENT=true

# ── Seed (npm run seed) ──────────────────────────────────────────────
ADMIN_NAME=Ankit
ADMIN_EMAIL=
# Wrap in quotes if it contains a #
ADMIN_PASSWORD=
