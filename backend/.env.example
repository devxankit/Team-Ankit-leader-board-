# Environment Configuration
NODE_ENV=development
PORT=5000

# Client Application URL(s)
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/my_app

# JWT Authentication
JWT_SECRET=super_secret_jwt_dev_key_change_in_production
JWT_EXPIRES_IN=7d

# Proxy Configuration
TRUST_PROXY=0

# Email Service (console | smtp | resend)
MAIL_PROVIDER=console
MAIL_FROM=App Support <no-reply@example.com>
MAIL_TO=admin@example.com

# SMTP Settings (Required if MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend API Key (Required if MAIL_PROVIDER=resend)
RESEND_API_KEY=

# Cloudflare Turnstile / Captcha (Optional)
TURNSTILE_SECRET_KEY=

# Spam & Rate Limits
MIN_FORM_FILL_MS=1500
MAX_FORM_AGE_MS=21600000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_UPLOAD_BYTES=5242880
